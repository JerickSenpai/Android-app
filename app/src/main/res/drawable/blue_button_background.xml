<?xml version="1.0" encoding="utf-8"?>
<!-- Save this as res/drawable/blue_button_background.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Shadow -->
            <item android:top="2dp" android:left="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#40000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Button background -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#005A94" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#004070" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state -->
    <item>
        <layer-list>
            <!-- Shadow -->
            <item android:top="4dp" android:left="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#30000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Button background -->
            <item android:bottom="4dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#0088E6"
                        android:endColor="#0071BC"
                        android:angle="270" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#005A94" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>